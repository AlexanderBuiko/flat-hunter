# flat-hunter configuration (copy to .env)

# Telegram bot (P1+): create a bot via @BotFather, put its token here.
FLAT_HUNTER_BOT_TOKEN=
# Comma-separated Telegram numeric user ids allowed to use the bot.
FLAT_HUNTER_ALLOWED_USER_IDS=

# How often the scheduler runs a scrape (seconds). Default 3h. Keep it polite.
FLAT_HUNTER_INTERVAL_S=10800

# SQLite location.
FLAT_HUNTER_DB=flat_hunter.db

# AI layer (P2+). Local Ollama is the default (cheap, offline); set to openrouter for cloud.
JARVIS_LLM_PROVIDER=ollama
# OPENROUTER_API_KEY=   # only if you switch the extractor/ranker to the cloud

# Per-user flood cap: at most FLAT_HUNTER_USER_RATE LLM-triggering actions (describe,
# edit, search) per user per FLAT_HUNTER_USER_RATE_WINDOW_S seconds. The gateway limiter
# is per-IP and cannot see individual Telegram users, so this is the per-user budget.
FLAT_HUNTER_USER_RATE=20
FLAT_HUNTER_USER_RATE_WINDOW_S=3600
